<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>ورود به Death Chat 💀</title>
    <style>
        body { background: #0a0a0a; color: #fff; font-family: Tahoma, sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; overflow: hidden; }
        .login-card { background: rgba(20, 20, 20, 0.85); border: 1px solid #ff4757; padding: 30px; border-radius: 12px; box-shadow: 0 0 20px rgba(255, 71, 87, 0.3); width: 300px; text-align: center; z-index: 10; }
        input { width: 90%; background: #111; border: 1px solid #333; color: #fff; padding: 12px; margin: 10px 0; border-radius: 6px; outline: none; }
        input:focus { border-color: #ff4757; }
        button { width: 100%; background: #ff4757; color: white; border: none; padding: 12px; border-radius: 6px; cursor: pointer; font-weight: bold; margin-top: 10px; transition: 0.3s; }
        button:hover { background: #ff6b81; box-shadow: 0 0 10px #ff4757; }
        .error { color: #ff4757; font-size: 13px; margin-bottom: 10px; }
        /* پس‌زمینه ستاره‌ای متحرک */
        .stars { position: absolute; width: 100%; height: 100%; top: 0; left: 0; z-index: 1; pointer-events: none; }
        .star { position: absolute; background: white; border-radius: 50%; animation: fall linear infinite; }
        @keyframes fall {
            0% { transform: translateY(-10px); opacity: 0; }
            50% { opacity: 1; }
            100% { transform: translateY(105vh); opacity: 0; }
        }
    </style>
</head>
<body>

    <div class="stars" id="stars"></div>

    <div class="login-card">
        <h2>💀 Death Login</h2>
        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>
        <form action="/login" method="POST">
            <input type="text" name="username" placeholder="نام کاربری (مثل admin)" required autocomplete="off">
            <input type="password" name="password" placeholder="رمز عبور" required>
            <button type="submit">ورود به دنیای مرگ ⚡</button>
        </form>
    </div>

    <script>
        // ساخت ستاره‌های متحرک پس‌زمینه
        const starsContainer = document.getElementById('stars');
        for (let i = 0; i < 50; i++) {
            const star = document.createElement('div');
            star.classList.add('star');
            star.style.left = Math.random() * 100 + 'vw';
            star.style.top = Math.random() * -100 + 'vh';
            star.style.animationDuration = (Math.random() * 3 + 2) + 's';
            star.style.animationDelay = Math.random() * 5 + 's';
            const size = Math.random() * 3 + 1 + 'px';
            star.style.width = size;
            star.style.height = size;
            starsContainer.appendChild(star);
        }
    </script>
</body>
</html>
